{
  "name": "storefront-master",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src worker",
    "check:client": "tsx scripts/check-client.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:budget": "tsx scripts/check-budget.ts",
    "prerender": "tsx scripts/prerender.ts",
    "build:seo": "NODE_ENV=production vite build && tsx scripts/prerender.ts",
    "dev:worker": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^7.0.9",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "gsap": "^3.15.1",
    "hono": "4.13.23",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.7",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "wrangler": "4.169.0"
  }
}
