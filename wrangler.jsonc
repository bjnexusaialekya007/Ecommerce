{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storefront",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "ENVIRONMENT": "local" },
  "env": {
    "staging": { "name": "storefront-staging", "vars": { "ENVIRONMENT": "staging" } },
    "production": { "name": "storefront-production", "vars": { "ENVIRONMENT": "production" } }
  }
}
